{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/cli.ts",
    "src/plugin-api.ts",
    "src/server-plugin-api.ts",
    "src/client/src/api.ts",
    "src/shared/apiTypes.ts",
    "src/server/types.ts",
    "src/server/piWebPluginService.ts",
    "extensions/pi-web.ts",
    "extensions/pi-web-permission-bridge.ts",
    "pi-web-plugins/**/pi-web-plugin.ts",
    "pi-web-plugins/**/server-plugin.ts",
    "pi-packages/**/pi-web-plugin.ts",
    "scripts/*.mjs",
    "scripts/perf/*.mjs"
  ],
  "project": [
    "src/**/*.ts",
    "extensions/**/*.ts",
    "pi-web-plugins/**/*.ts",
    "pi-packages/**/*.ts"
  ],
  "ignoreDependencies": [
    "@gotgenes/pi-permission-system"
  ],
  "ignoreExportsUsedInFile": true
}
